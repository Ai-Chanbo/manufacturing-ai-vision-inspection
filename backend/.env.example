# Vision Inspection API - 環境変数設定テンプレート
# このファイルをコピーして .env にリネームし、実環境に合わせて編集してください。
# .env は .gitignore で除外されているためリポジトリにはコミットされません。

# ONNX モデルファイルのパス（絶対パスまたは backend/ からの相対パス）
MODEL_PATH=models/sample_model.onnx

# NG判定閾値（0.0〜1.0）
NG_THRESHOLD=0.5

# API バインドアドレス（工場内LAN固定IPにする場合は変更）
API_HOST=0.0.0.0
API_PORT=8000

# デノイズ処理（true=有効、false=無効）
# 有効にすると推論時間が100〜500ms増加する。通常は false のまま運用する。
ENABLE_DENOISING=false
